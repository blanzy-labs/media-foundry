{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mf008c-creative-control.schema.json",
  "title": "MF-008C Unknown Process Creative Control",
  "type": "object",
  "additionalProperties": false,
  "required": ["mechanism", "events", "timing", "palette_profile", "camera_profile", "node_profile", "projection_profile", "cta_profile", "audio_cue"],
  "properties": {
    "mechanism": {"enum": ["tracking", "classification_link", "biometric_scan"]},
    "events": {
      "type": "array",
      "minItems": 3,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {"type": "string"}
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intro_seconds", "investigation_seconds", "result_hold_seconds", "cta_seconds"],
      "properties": {
        "intro_seconds": {"type": "number", "minimum": 5.0, "maximum": 7.0},
        "investigation_seconds": {"type": "number", "minimum": 10.0, "maximum": 14.0},
        "result_hold_seconds": {"type": "number", "minimum": 1.0, "maximum": 3.0},
        "cta_seconds": {"type": "number", "minimum": 5.0, "maximum": 8.0}
      }
    },
    "palette_profile": {"enum": ["baseline", "pursuit", "mystery", "revelation"]},
    "camera_profile": {"enum": ["baseline", "tight_pursuit", "wide_investigation", "calm_to_push"]},
    "node_profile": {"enum": ["baseline", "urgent", "analytical", "stable_then_overload"]},
    "projection_profile": {"enum": ["baseline", "warning_trace", "classification", "biometric"]},
    "cta_profile": {"enum": ["baseline", "warning", "cool_signal", "revelation"]},
    "audio_cue": {"enum": ["baseline_full", "pursuit", "investigation", "revelation"]}
  }
}
