{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mf016-composition.schema.json",
  "title": "Media Foundry semantic composition manifest",
  "type": "object",
  "required": ["version", "scene_id", "complex_scene", "canvas", "composition", "gate", "approval", "hierarchy", "policies", "zones", "objects"],
  "properties": {
    "version": {"const": 1},
    "scene_id": {"type": "string", "minLength": 1},
    "complex_scene": {"type": "boolean"},
    "zones": {"type": "array", "minItems": 7},
    "objects": {"type": "array", "minItems": 1},
    "gate": {"type": "object", "required": ["state", "human_approval_required"]},
    "approval": {"type": "object", "required": ["human_status", "reviewer"]}
  }
}
